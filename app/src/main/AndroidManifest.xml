<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Redensity"
        android:allowBackup="true"
        android:supportsRtl="true">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.redensity.app.shizuku"
            android:multiprocess="false"
            android:exported="true"
            android:enabled="true"
            android:grantUriPermissions="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".CommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.redensity.app.COMMAND" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".CommandActivity"
            android:exported="true"
            android:theme="@style/Redensity.Command"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask" />
    </application>

</manifest>
